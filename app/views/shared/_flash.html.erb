<% if flash.present? %>
  <div class="tp-flash" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <% flash_type = type.to_sym == :notice ? "success" : "error" %>
      <% icon_name = flash_type == "success" ? "check" : "alert_circle" %>
      <div class="tp-flash__item" data-controller="flash" data-action="click->flash#dismiss">
        <div class="tp-flash__inner tp-flash__inner--<%= flash_type %>">
          <span class="tp-flash__icon"><%= icon(icon_name, size: 20) %></span>
          <span class="tp-flash__text"><%= message %></span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
