<% time_label =
  if activity.start_time.present? && activity.end_time.present?
    "#{activity.start_time.strftime('%H:%M')}〜#{activity.end_time.strftime('%H:%M')}"
  elsif activity.start_time.present?
    "#{activity.start_time.strftime('%H:%M')}〜"
  elsif activity.end_time.present?
    "〜#{activity.end_time.strftime('%H:%M')}"
  else
    "−"
  end %>
<% cost_value = activity.cost.presence || 0 %>
<% location_text = activity.location.presence %>
<% location_style = [
  "margin: 0",
  "font-size: 14px",
  "color: #4b5563",
  "display: inline-flex",
  "align-items: center",
  ("gap: 8px" if location_text)
].compact.join('; ') %>

<%= link_to trip_activity_path(activity.trip, activity), class: "itinerary-row", style: [
  "display: flex",
  "padding: 16px",
  "border: 1px solid #e5e7eb",
  "border-radius: 16px",
  "background: #ffffff",
  "cursor: pointer",
  "text-decoration: none",
  "color: inherit",
  "transition: box-shadow 0.2s ease"
].join('; ') do %>
  <div class="itinerary-row-time" style="flex: 0 0 auto; width: 128px; color: #374151; font-size: 16px; line-height: 1.4; white-space: nowrap; display: inline-flex; align-items: center; gap: 8px; font-variant-numeric: tabular-nums;">
    <%= icon("clock", size: 16) %>
    <%= time_label %>
  </div>
  <div class="itinerary-row-content" style="flex: 1; min-width: 160px; display: flex; flex-direction: column; justify-content: center;">
    <p style="margin: 0 0 4px; font-size: 16px; font-weight: 600; color: #111827; line-height: 1.4;"><%= activity.title %></p>
    <p style="<%= location_style %>">
      <%= icon("map_pin", size: 14) %>
      <% if location_text %>
        <span><%= location_text %></span>
      <% end %>
    </p>
  </div>
  <div class="itinerary-row-meta" style="display: flex; align-items: center; gap: 12px; margin-left: auto; align-self: stretch; position: relative; padding-right: 40px;">
    <div class="itinerary-row-cost" style="flex-shrink: 0; text-align: right;">
      <p style="margin: 0; font-size: 16px; font-weight: 600; color: #111827; font-variant-numeric: tabular-nums;">
        <%= number_to_currency(cost_value, unit: "¥", precision: 0) %>
      </p>
    </div>
    <span class="itinerary-row-chevron" style="color: #9ca3af; font-size: 20px; line-height: 1; position: absolute; right: 6px; top: 50%; transform: translateY(-50%);">&gt;</span>
  </div>
<% end %>
